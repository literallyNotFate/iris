# Theme: {{ theme_name }}, generated by Iris

[colors.primary]
background = "{{ bg }}"
foreground = "{{ fg }}"

[colors.cursor]
cursor = "{{ white }}"
text   = "{{ bg }}"

[colors.selection]
background = "{{ sel }}"
text       = "{{ fg }}"

[colors.normal]
black   = "{{ ansi.0 }}"
red     = "{{ ansi.1 }}"
green   = "{{ ansi.2 }}"
yellow  = "{{ ansi.3 }}"
blue    = "{{ ansi.4 }}"
magenta = "{{ ansi.5 }}"
cyan    = "{{ ansi.6 }}"
white   = "{{ ansi.7 }}"

[colors.bright]
black   = "{{ ansi.8 }}"
red     = "{{ ansi.9 }}"
green   = "{{ ansi.10 }}"
yellow  = "{{ ansi.11 }}"
blue    = "{{ ansi.12 }}"
magenta = "{{ ansi.13 }}"
cyan    = "{{ ansi.14 }}"
white   = "{{ ansi.15 }}"
