# Theme: {{ theme_name }}, generated by Iris
# vim:fileencoding=utf-8:foldmethod=marker

[manager]
cwd = { fg = "{{ ansi.9 }}", bold = true }

hovered         = { fg = "{{ bg }}", bg = "{{ ansi.3 }}", bold = true }
preview_hovered = { underline = true }
symlink_target  = { fg = "{{ ansi.8 }}" }

find_keyword  = { fg = "{{ ansi.11 }}", bold = true }
find_position = { fg = "{{ ansi.13 }}" }

marker_selected = { fg = "{{ ansi.10 }}", bold = true }
marker_copied   = { fg = "{{ ansi.11 }}", bold = true }
marker_cut      = { fg = "{{ ansi.1 }}", bold = true }

tab_active   = { fg = "{{ bg }}", bg = "{{ ansi.6 }}", bold = true }
tab_inactive = { fg = "{{ ansi.7 }}", bg = "{{ line_hl }}" }
tab_width    = 1

border_symbol = "│"
border_style  = { fg = "{{ ansi.7 }}" }

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "{{ line_hl }}", bg = "{{ line_hl }}" }

mode_normal = { fg = "{{ bg }}", bg = "{{ ansi.14 }}",    bold = true }
mode_select = { fg = "{{ bg }}", bg = "{{ ansi.10 }}",   bold = true }
mode_unset  = { fg = "{{ bg }}", bg = "{{ ansi.13 }}", bold = true }

filename    = { fg = "{{ fg }}", bold = true }
filesize    = { fg = "{{ ansi.7 }}" }
permissions = { fg = "{{ ansi.8 }}" }

progress_label  = { fg = "{{ ansi.11 }}", bold = true }
progress_normal = { fg = "{{ ansi.6 }}" }
progress_error  = { fg = "{{ ansi.1 }}" }

permissions_t = { fg = "{{ ansi.14 }}" }
permissions_r = { fg = "{{ ansi.11 }}" }
permissions_w = { fg = "{{ ansi.1 }}" }
permissions_x = { fg = "{{ ansi.10 }}" }
permissions_s = { fg = "{{ ansi.7 }}" }

[filetype]
rules = [
  { name = "*/",                            fg = "{{ ansi.10 }}", bold = true },
  { mime = "text/x-shellscript",            fg = "{{ ansi.2 }}", bold = true },
  { mime = "image/*",                       fg = "{{ ansi.14 }}" },
  { mime = "video/*",                       fg = "{{ ansi.11 }}" },
  { mime = "audio/*",                       fg = "{{ ansi.5 }}" },
  { mime = "application/pdf",               fg = "{{ ansi.1 }}", bold = true },
  { mime = "text/markdown",                 fg = "{{ ansi.11 }}", italic = true },
  { mime = "text/x-rust",                   fg = "{{ ansi.9 }}" },
  { name = "*",                             fg = "{{ fg }}" },
]

[icon]
conds = [
  { if = "dir & hovered", text = "󰉖",  fg = "{{ bg }}",  bg = "{{ ansi.3 }}" },
  { if = "dir",           text = "󰉖",  fg = "{{ ansi.10 }}" },
  { if = "!dir",          text = "󰈔",  fg = "{{ fg }}" },
]
