# Theme: {{ theme_name }}, generated by Iris
# vim:fileencoding=utf-8:foldmethod=marker

[manager]
cwd = { fg = "{{ br_red }}", bold = true }

hovered         = { fg = "{{ bg }}", bg = "{{ orange }}", bold = true }
preview_hovered = { underline = true }
symlink_target = { fg = "{{ gutter_fg }}" }

find_keyword  = { fg = "{{ br_orange }}", bold = true }
find_position = { fg = "{{ br_magenta }}" }

marker_selected = { fg = "{{ br_green }}", bold = true }
marker_copied   = { fg = "{{ br_orange }}", bold = true }
marker_cut      = { fg = "{{ br_red }}", bold = true }

tab_active   = { fg = "{{ bg }}", bg = "{{ teal }}", bold = true }
tab_inactive = { fg = "{{ tan }}", bg = "{{ line_hl }}" }
tab_width    = 1

border_symbol = "│"
border_style  = { fg = "{{ tan }}" }

[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "{{ line_hl }}", bg = "{{ line_hl }}" }

mode_normal = { fg = "{{ bg }}", bg = "{{ br_teal }}",    bold = true }
mode_select = { fg = "{{ bg }}", bg = "{{ br_green }}",   bold = true }
mode_unset  = { fg = "{{ bg }}", bg = "{{ br_magenta }}", bold = true }

filename    = { fg = "{{ white }}", bold = true }
filesize    = { fg = "{{ tan }}" }
permissions = { fg = "{{ comment }}" }

progress_label  = { fg = "{{ br_orange }}", bold = true }
progress_normal = { fg = "{{ teal }}" }
progress_error  = { fg = "{{ red }}" }

permissions_t = { fg = "{{ br_teal }}" }
permissions_r = { fg = "{{ br_orange }}" }
permissions_w = { fg = "{{ red }}" }
permissions_x = { fg = "{{ br_green }}" }
permissions_s = { fg = "{{ tan }}" }

[filetype]
rules = [
  { name = "*/",                            fg = "{{ br_green }}", bold = true },
  { mime = "text/x-shellscript",            fg = "{{ green }}", bold = true },
  { mime = "image/*",                       fg = "{{ br_teal }}" },
  { mime = "video/*",                       fg = "{{ br_orange }}" },
  { mime = "audio/*",                       fg = "{{ magenta }}" },
  { mime = "application/pdf",               fg = "{{ red }}", bold = true },
  { mime = "text/markdown",                 fg = "{{ br_orange }}", italic = true },
  { mime = "text/x-rust",                   fg = "{{ br_red }}" },
  { name = "*",                             fg = "{{ fg }}" },
]

[icon]
conds = [
  { if = "dir & hovered", text = "󰉖",  fg = "{{ bg }}",  bg = "{{ orange }}" },
  { if = "dir",           text = "󰉖",  fg = "{{ br_green }}" },
  { if = "!dir",          text = "󰈔",  fg = "{{ fg }}" },
]
